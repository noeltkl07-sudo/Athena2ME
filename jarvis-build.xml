<?xml version="1.0" encoding="UTF-8"?>
<project name="JarvisMotorola" default="all" basedir=".">
  <property name="out" value="jarvis-out"/>
  <path id="j2me.libs">
    <pathelement location="lib/cldcapi11.jar"/>
    <pathelement location="lib/midpapi20.jar"/>
  </path>
  <target name="compile">
    <mkdir dir="${out}/classes"/>
    <javac srcdir="src" destdir="${out}/classes" includes="Jarvis.java"
           source="1.3" target="1.3" debug="false" includeantruntime="false"
           bootclasspathref="j2me.libs"/>
  </target>
  <target name="package" depends="compile">
    <jar destfile="${out}/JARVIS-unverified.jar">
      <manifest>
        <attribute name="Manifest-Version" value="1.0"/>
        <attribute name="MIDlet-Name" value="JARVIS"/>
        <attribute name="MIDlet-Version" value="1.2"/>
        <attribute name="MIDlet-Vendor" value="Noel"/>
        <attribute name="MIDlet-1" value="JARVIS, , Jarvis"/>
        <attribute name="MicroEdition-Configuration" value="CLDC-1.0"/>
        <attribute name="MicroEdition-Profile" value="MIDP-2.0"/>
      </manifest>
      <fileset dir="${out}/classes" includes="Jarvis.class"/>
    </jar>
  </target>
  <target name="preverify" depends="package">
    <java jar="tools/proguard.jar" fork="true" failonerror="true">
      <arg value="-injars"/><arg value="${out}/JARVIS-unverified.jar"/>
      <arg value="-outjars"/><arg value="${out}/JARVIS.jar"/>
      <arg value="-libraryjars"/><arg value="lib/cldcapi11.jar${path.separator}lib/midpapi20.jar"/>
      <arg value="-microedition"/>
      <arg value="-dontshrink"/><arg value="-dontoptimize"/><arg value="-dontobfuscate"/>
      <arg value="-keep"/><arg value="public class Jarvis extends javax.microedition.midlet.MIDlet { *; }"/>
    </java>
  </target>
  <target name="all" depends="preverify">
    <length file="${out}/JARVIS.jar" property="jarbytes"/>
    <echo file="${out}/JARVIS.jad">MIDlet-Name: JARVIS
MIDlet-Version: 1.2
MIDlet-Vendor: Noel
MIDlet-1: JARVIS, , Jarvis
MIDlet-Jar-URL: JARVIS.jar
MIDlet-Jar-Size: ${jarbytes}
MicroEdition-Configuration: CLDC-1.0
MicroEdition-Profile: MIDP-2.0
</echo>
  </target>
</project>
